{
    "name": "pychivalry-engine",
    "version": "2.2.0",
    "description": "CK3 script engine core: parser, registry, schema and scope checks driven by the engine-derived spec package",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/Cyborgninja21/pychivalry.git",
        "directory": "packages/engine"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "pychivalry-engine": "dist/cli.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json && node scripts/copy-spec.js",
        "prewatch": "node scripts/copy-spec.js",
        "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
        "build:test": "tsc -p tsconfig.test.json",
        "test": "npm run build && npm run build:test && mocha --timeout 60000 \"out/test/**/*.test.js\"",
        "lint": "eslint src test --ext ts --max-warnings=0",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
    },
    "devDependencies": {
        "@types/mocha": "^10.0.0",
        "@types/node": "^18.0.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.0.0",
        "mocha": "^10.0.0",
        "prettier": "^3.0.0",
        "typescript": "^5.0.0"
    }
}
