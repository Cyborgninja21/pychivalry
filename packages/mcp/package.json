{
    "name": "@pychivalry/mcp",
    "version": "0.0.0",
    "private": true,
    "description": "The agent server (MCP), a thin shell over @pychivalry/core.",
    "license": "Apache-2.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "pychivalry-mcp": "dist/main.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./hosting": {
            "types": "./dist/hosting.d.ts",
            "default": "./dist/hosting.js"
        }
    },
    "dependencies": {
        "@modelcontextprotocol/server": "2.4.0",
        "@pychivalry/core": "0.0.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "2.4.0"
    },
    "scripts": {
        "test": "node --test \"dist/**/*.test.js\""
    }
}
