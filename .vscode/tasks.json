{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ci",
            "type": "shell",
            "command": "task ci",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$tsc"]
        },
        {
            "label": "build",
            "type": "shell",
            "command": "task build",
            "group": "build",
            "problemMatcher": ["$tsc"]
        },
        {
            "label": "test",
            "type": "shell",
            "command": "task test",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        }
    ]
}
