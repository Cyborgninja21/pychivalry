{
  "version": "2.0.0",
  "tasks": [
    // ── Install & Build ──────────────────────────────────────────
    {
      "label": "Install Extension Dependencies",
      "type": "npm",
      "script": "install",
      "path": "vscode-extension/",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false
      }
    },
    {
      "label": "Build Extension (Install + Compile)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Install Extension Dependencies",
        "npm: compile"
      ],
      "problemMatcher": []
    },
    {
      "label": "npm: compile",
      "type": "npm",
      "script": "compile",
      "path": "vscode-extension/",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Compile Tests",
      "type": "npm",
      "script": "compile-tests",
      "path": "vscode-extension/",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "npm: watch",
      "type": "npm",
      "script": "watch",
      "path": "vscode-extension/",
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc-watch",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*\\d{1,2}:\\d{1,2}:\\d{1,2}(?: AM| PM)? - File change detected\\. Starting incremental compilation\\.\\.\\.",
          "endsPattern": "^\\s*\\d{1,2}:\\d{1,2}:\\d{1,2}(?: AM| PM)? - (?:Compilation complete\\.|Found \\d+ errors?\\. Watching for file changes\\.)"
        }
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    },
    // ── Tests ────────────────────────────────────────────────────
    {
      "label": "Run Extension Tests",
      "type": "npm",
      "script": "test",
      "path": "vscode-extension/",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Run Extension Tests (Quick)",
      "type": "npm",
      "script": "test:quick",
      "path": "vscode-extension/",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Unit Tests",
      "type": "npm",
      "script": "test:unit",
      "path": "vscode-extension/",
      "dependsOn": ["Compile Tests"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Example Mod Validation Tests",
      "type": "npm",
      "script": "test:examples",
      "path": "vscode-extension/",
      "dependsOn": ["Compile Tests"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Watch Extension Tests",
      "type": "npm",
      "script": "test:watch",
      "path": "vscode-extension/",
      "isBackground": true,
      "problemMatcher": {
        "owner": "mocha",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*starting.*$",
          "endsPattern": "^.*tests complete.*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    // ── Code Quality ─────────────────────────────────────────────
    {
      "label": "Lint",
      "type": "npm",
      "script": "lint",
      "path": "vscode-extension/",
      "problemMatcher": "$eslint-stylish",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Format Check",
      "type": "npm",
      "script": "format-check",
      "path": "vscode-extension/",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Format",
      "type": "npm",
      "script": "format",
      "path": "vscode-extension/",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}