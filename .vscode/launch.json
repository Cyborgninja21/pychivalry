{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🎯 Extension - Full Rebuild",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}/example mod"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "Build Extension (Install + Compile)",
      "presentation": {
        "group": "1-extension",
        "order": 1
      }
    },
    {
      "name": "🎯 Extension - Quick Compile",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}/example mod"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "npm: compile",
      "presentation": {
        "group": "1-extension",
        "order": 2
      }
    },
    {
      "name": "🎯 Extension - Watch Mode",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}/example mod"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "npm: watch",
      "presentation": {
        "group": "1-extension",
        "order": 3
      }
    }
  ]
}