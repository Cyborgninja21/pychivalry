{
  "version": "0.2.0",
  "configurations": [
    // TypeScript server runs in-process with the extension, no separate launch needed
    // Use "🎯 Extension" configs below to debug the full stack

    // Legacy Python server configs (only use if serverImplementation is "python")
    {
      "name": "🐍 Python Server (Legacy) - Full Reinstall",
      "type": "debugpy",
      "request": "launch",
      "module": "pychivalry.server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "preLaunchTask": "Install Python Dependencies",
      "presentation": {
        "group": "3-legacy-python",
        "order": 1
      }
    },
    {
      "name": "🐍 Python Server (Legacy) - Quick Launch",
      "type": "debugpy",
      "request": "launch",
      "module": "pychivalry.server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": {
        "group": "3-legacy-python",
        "order": 2
      }
    },
    {
      "name": "🎯 Extension - Full Rebuild",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}/example mod"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "Build Extension (Install + Compile)",
      "presentation": {
        "group": "1-extension",
        "order": 1
      }
    },
    {
      "name": "🎯 Extension - Quick Compile",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}/example mod"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "npm: compile",
      "presentation": {
        "group": "1-extension",
        "order": 2
      }
    },
    {
      "name": "🎯 Extension - Watch Mode",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}/example mod"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "npm: watch",
      "presentation": {
        "group": "1-extension",
        "order": 3
      }
    }
  ],
  "compounds": [
    // Legacy compound: Only use if you need to debug the Python server
    // alongside an extension that explicitly uses serverImplementation: "python"
    {
      "name": "🐍 Python + Extension (Legacy)",
      "configurations": [
        "🐍 Python Server (Legacy) - Quick Launch",
        "🎯 Extension - Quick Compile"
      ],
      "stopAll": true,
      "presentation": {
        "group": "4-legacy-compounds",
        "order": 1
      }
    }
  ]
}