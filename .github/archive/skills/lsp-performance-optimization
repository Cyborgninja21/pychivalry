## Optimization Strategies

### 1. Cache Parser Results

**Problem:** Re-parsing unchanged documents

**Solution:** Cache AST with document version

```typescript
class DocumentCache {
    private cache = new Map<string, { version: number; ast: any }>();
    
    get(uri: string, version: number) {
        const cached = this.cache.get(uri);
        if (cached && cached.version === version) {
            return cached.ast;
        }
        return null;
    }
    
    set(uri: string, version: number, ast: any) {
        this.cache.set(uri, { version, ast });
    }
}
```

### 2. Incremental Parsing

**Problem:** Full re-parse on every change

**Solution:** Parse only changed regions

```typescript
function incrementalParse(oldAst: any, changeRange: Range, newText: string) {
    // Identify affected nodes
    const affected = findNodesInRange(oldAst, changeRange);
    
    // Re-parse only affected subtree
    const newSubtree = parseText(newText);
    
    // Replace in AST
    replaceSubtree(oldAst, affected, newSubtree);
    
    return oldAst;
}
```

### 3. Lazy Validation

**Problem:** All validators run on every change

**Solution:** Debounce and prioritize validation

```typescript
class DebounceValidator {
    private delay: number;
    private timeoutId?: NodeJS.Timeout;
    
    constructor(delay = 500) {
        this.delay = delay;
    }
    
    debounceValidate(validateFn: () => Promise<void>) {
        if (this.timeoutId) {
            clearTimeout(this.timeoutId);
        }
        
        this.timeoutId = setTimeout(async () => {
            await validateFn();
        }, this.delay);
    }
}
```

### 4. Background Indexing

**Problem:** Indexing blocks main thread

**Solution:** Index in background with progress

```typescript
import { Worker } from 'worker_threads';

class BackgroundIndexer {
    private workers = new Set<Worker>();
    
    async indexWorkspace(workspacePath: string): Promise<void> {
        return new Promise((resolve, reject) => {
            const worker = new Worker('./indexer-worker.js', {
                workerData: { workspacePath }
            });
            
            this.workers.add(worker);
            
            worker.on('message', (result) => {
                this.workers.delete(worker);
                resolve(result);
            });
            
            worker.on('error', reject);
        });
    }
}
```

### 5. Limit Scope of Operations

**Problem:** Processing entire workspace on every request

**Solution:** Process only relevant files

```typescript
function findReferences(symbol: string, workspace: Workspace) {
    // Bad: Search all files
    // for (const file of workspace.allFiles) {
    //     searchFile(file, symbol);
    // }
    
    // Good: Search only likely locations
    const candidates = workspace.index.getFilesWithSymbol(symbol);
    for (const file of candidates) {
        searchFile(file, symbol);
    }
}
```

### 6. Optimize Data Structures

**Problem:** Slow lookups in large dictionaries

**Solution:** Use appropriate data structures

```typescript
// Bad: Array for many lookups
const traits = ["brave", "craven"];  // O(n) lookup

// Good: Set for membership testing
const traits = new Set(["brave", "craven"]);  // O(1) lookup

// Good: Trie for prefix matching
class Trie {
    private root = new Map<string, any>();
    
    add(word: string) {
        let node = this.root;
        for (const char of word) {
            if (!node.has(char)) {
                node.set(char, new Map());
            }
            node = node.get(char);
        }
        node.set('$', true);
    }
    
    searchPrefix(prefix: string): string[] {
        let node = this.root;
        for (const char of prefix) {
            if (!node.has(char)) {
                return [];
            }
            node = node.get(char);
        }
        return this.collectWords(node, prefix);
    }
}
```

### 7. Batch Document Updates

**Problem:** Many small document updates

**Solution:** Batch changes and process once

```typescript
class BatchProcessor {
    private batchSize: number;
    private timeout: number;
    private pending: any[] = [];
    private timeoutId?: NodeJS.Timeout;
    
    constructor(batchSize = 10, timeout = 1000) {
        this.batchSize = batchSize;
        this.timeout = timeout;
    }
    
    async add(item: any) {
        this.pending.push(item);
        
        if (this.pending.length >= this.batchSize) {
            await this.processBatch();
        } else if (!this.timeoutId) {
            this.timeoutId = setTimeout(() => this.processBatch(), this.timeout);
        }
    }
    
    private async processBatch() {
        if (this.pending.length > 0) {
            const batch = [...this.pending];
            this.pending = [];
            await this.process(batch);
        }
        if (this.timeoutId) {
            clearTimeout(this.timeoutId);
            this.timeoutId = undefined;
        }
    }
}
```

### 8. Stream Large Results

**Problem:** Returning huge completion lists

**Solution:** Paginate or stream results

```typescript
async function getCompletions(position: Position, limit = 100) {
    const allItems = computeAllCompletions(position);
    
    // Return top N most relevant
    const scored = scoreCompletions(allItems, position);
    return scored.sort((a, b) => b.score - a.score).slice(0, limit);
}
```

## Memory Optimization

### 1. Release Document Cache

```typescript
class DocumentManager {
    private maxCacheSize: number;
    private cache = new Map<string, any>();
    private accessOrder: string[] = [];
    
    constructor(maxCacheSize = 50) {
        this.maxCacheSize = maxCacheSize;
    }
    
    add(uri: string, document: any) {
        if (this.cache.size >= this.maxCacheSize) {
            const oldest = this.accessOrder.shift();
            if (oldest) {
                this.cache.delete(oldest);
            }
        }
        this.cache.set(uri, document);
        this.accessOrder.push(uri);
    }
}
```

### 2. Use Weak References for Cross-References

```typescript
class Symbol {
    private references = new Set<WeakRef<any>>();
    
    addWeakReference(ref: any) {
        this.references.add(new WeakRef(ref));
    }
    
    getReferences() {
        const valid: any[] = [];
        for (const weakRef of this.references) {
            const ref = weakRef.deref();
            if (ref) {
                valid.push(ref);
            } else {
                this.references.delete(weakRef);
            }
        }
        return valid;
    }
}
```

### 3. Avoid Storing Full Text

```typescript
// Bad: Store entire document
class Document {
    text: string;  // Could be megabytes
    lines: string[];
    
    constructor(text: string) {
        this.text = text;
        this.lines = text.split('\n');
    }
}

// Good: Store only metadata
class Document {
    uri: string;
    version = 0;
    ast?: any;  // Parsed structure, not text
    
    constructor(uri: string) {
        this.uri = uri;
    }
}
```

## Monitoring Performance

### Add Performance Metrics

```typescript
import { performance } from 'perf_hooks';

function measureTime<T>(target: any, propertyKey: string, descriptor: PropertyDescriptor) {
    const originalMethod = descriptor.value;
    
    descriptor.value = async function (...args: any[]) {
        const start = performance.now();
        const result = await originalMethod.apply(this, args);
        const elapsed = performance.now() - start;
        
        if (elapsed > 100) {  // Log slow operations
            console.warn(`${propertyKey} took ${elapsed.toFixed(3)}ms`);
        }
        
        return result;
    };
}

// Usage:
class Handler {
    @measureTime
    async completionHandler(params: any) {
        // Implementation
    }
}
```

