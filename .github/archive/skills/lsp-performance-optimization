## Performance Testing

```typescript
import * as assert from 'assert';
import { performance } from 'perf_hooks';

describe('Performance Tests', () => {
    it('should ensure completions are fast enough', () => {
        const runCompletion = () => {
            return getCompletions(sampleDocument, 10, 5);
        };
        
        const start = performance.now();
        const result = runCompletion();
        const elapsed = performance.now() - start;
        
        assert.ok(result.length > 0);
        assert.ok(elapsed < 100);  // Should complete in < 100ms
    });
    
    it('should parse large file quickly', () => {
        const largeFile = 'has_trait = brave\n'.repeat(10000);
        
        const start = performance.now();
        const ast = parser.parse(largeFile);
        const elapsed = performance.now() - start;
        
        assert.ok(elapsed < 1000);  // Should complete in < 1 second
        assert.ok(ast !== null);
    });
});
```

