{
    "$schema": "../presentation.schema.json",
    "folder": "common/story_cycles",
    "from": ["story_cycles.yaml"],
    "outline": {
        "symbol": "Class",
        "blocks": [
            {
                "field": "on_setup",
                "symbol": "Function"
            },
            {
                "field": "on_end",
                "symbol": "Function"
            },
            {
                "field": "on_owner_death",
                "symbol": "Function"
            },
            {
                "field": "effect_group",
                "symbol": "Method",
                "label": "effect_group {n}"
            }
        ]
    },
    "snippets": [
        {
            "label": "story cycle",
            "description": "A new story: what starts and ends it, and an effect group that runs every few days",
            "at": "record",
            "body": [
                "${1:my_story} = {",
                "\ton_setup = {$2}",
                "\ton_end = {$3}",
                "\ton_owner_death = {",
                "\t\tscope:story = { end_story = yes }",
                "\t}",
                "\teffect_group = {",
                "\t\tdays = ${4:30}",
                "\t\ttriggered_effect = {",
                "\t\t\ttrigger = { ${5:always = yes} }",
                "\t\t\teffect = {$0}",
                "\t\t}",
                "\t}",
                "}"
            ]
        },
        {
            "label": "on_setup",
            "description": "What happens when the story starts",
            "at": "field",
            "field": "on_setup",
            "body": ["on_setup = {$0}"]
        },
        {
            "label": "on_end",
            "description": "What happens when the story ends",
            "at": "field",
            "field": "on_end",
            "body": ["on_end = {$0}"]
        },
        {
            "label": "on_owner_death",
            "description": "What happens when the story's owner dies",
            "at": "field",
            "field": "on_owner_death",
            "body": ["on_owner_death = {", "\tscope:story = { end_story = yes }", "}"]
        },
        {
            "label": "effect_group",
            "description": "Effects run every few days while the story lasts",
            "at": "field",
            "field": "effect_group",
            "body": [
                "effect_group = {",
                "\tdays = ${1:30}",
                "\ttrigger = {$2}",
                "\ttriggered_effect = {",
                "\t\ttrigger = {$3}",
                "\t\teffect = {$0}",
                "\t}",
                "}"
            ]
        },
        {
            "label": "triggered_effect",
            "description": "Effects run when their trigger holds",
            "at": "field",
            "block": "effect_group",
            "field": "triggered_effect",
            "body": ["triggered_effect = {", "\ttrigger = {$1}", "\teffect = {$0}", "}"]
        },
        {
            "label": "first_valid",
            "description": "The first triggered effect whose trigger holds",
            "at": "field",
            "block": "effect_group",
            "field": "first_valid",
            "body": [
                "first_valid = {",
                "\ttriggered_effect = {",
                "\t\ttrigger = {$1}",
                "\t\teffect = {$2}",
                "\t}",
                "\ttriggered_effect = {",
                "\t\ttrigger = { always = yes }",
                "\t\teffect = {$0}",
                "\t}",
                "}"
            ]
        },
        {
            "label": "random_valid",
            "description": "One triggered effect whose trigger holds, picked at random",
            "at": "field",
            "block": "effect_group",
            "field": "random_valid",
            "body": [
                "random_valid = {",
                "\ttriggered_effect = {",
                "\t\ttrigger = {$1}",
                "\t\teffect = {$2}",
                "\t}",
                "\ttriggered_effect = {",
                "\t\ttrigger = {$3}",
                "\t\teffect = {$0}",
                "\t}",
                "}"
            ]
        }
    ]
}
