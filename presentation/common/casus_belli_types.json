{
    "$schema": "../presentation.schema.json",
    "folder": "common/casus_belli_types",
    "from": ["casus_belli_types.yaml"],
    "outline": {
        "symbol": "Class",
        "blocks": []
    },
    "snippets": [
        {
            "label": "casus belli",
            "description": "A new casus belli: its group, names, conditions and outcomes",
            "at": "record",
            "body": [
                "${1:my_casus_belli} = {",
                "\tgroup = ${2:conquest}",
                "\twar_name = ${1:my_casus_belli}_war_name",
                "\ton_invalidated_desc = ${3:msg_invalidate_war_title}",
                "\tvalid_to_start = {$4}",
                "\ton_victory = {$5}",
                "\ton_white_peace = {$6}",
                "\ton_defeat = {$0}",
                "}"
            ]
        },
        {
            "label": "valid_to_start",
            "description": "The conditions for a war to be declared with it",
            "at": "field",
            "field": "valid_to_start",
            "body": ["valid_to_start = {$0}"]
        },
        {
            "label": "on_victory",
            "description": "What the attacker's victory does",
            "at": "field",
            "field": "on_victory",
            "body": ["on_victory = {$0}"]
        },
        {
            "label": "on_defeat",
            "description": "What the attacker's defeat does",
            "at": "field",
            "field": "on_defeat",
            "body": ["on_defeat = {$0}"]
        }
    ]
}
