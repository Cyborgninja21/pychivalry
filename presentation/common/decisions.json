{
    "$schema": "../presentation.schema.json",
    "folder": "common/decisions",
    "from": ["decisions.yaml"],
    "outline": {
        "symbol": "Function",
        "detail": "{title}",
        "blocks": [
            {
                "field": "is_shown",
                "symbol": "Object"
            },
            {
                "field": "is_valid",
                "symbol": "Object"
            },
            {
                "field": "effect",
                "symbol": "Function"
            },
            {
                "field": "cost",
                "symbol": "Object"
            },
            {
                "field": "ai_will_do",
                "symbol": "Object"
            }
        ]
    },
    "snippets": [
        {
            "label": "decision",
            "description": "A new decision: its picture, texts, conditions, effect and AI weight",
            "at": "record",
            "body": [
                "${1:my_decision} = {",
                "\tpicture = { reference = \"${2:gfx/interface/illustrations/decisions/decision_misc.dds}\" }",
                "\tdesc = ${1:my_decision}_desc",
                "\tselection_tooltip = ${1:my_decision}_tooltip",
                "\tai_check_interval = ${3:120}",
                "\tis_shown = { ${4:is_ruler = yes} }",
                "\tis_valid = { ${5:is_adult = yes} }",
                "\teffect = {$0}",
                "\tai_potential = { always = yes }",
                "\tai_will_do = { base = ${6:0} }",
                "}"
            ]
        },
        {
            "label": "ai_check_interval",
            "description": "How many months pass between two looks of the AI at the decision",
            "at": "field",
            "field": "ai_check_interval",
            "body": ["ai_check_interval = ${1:120}"]
        },
        {
            "label": "is_shown",
            "description": "The conditions for the decision to be shown",
            "at": "field",
            "field": "is_shown",
            "body": ["is_shown = {$0}"]
        },
        {
            "label": "is_valid",
            "description": "The conditions for the decision to be taken",
            "at": "field",
            "field": "is_valid",
            "body": ["is_valid = {$0}"]
        },
        {
            "label": "effect",
            "description": "What taking the decision does",
            "at": "field",
            "field": "effect",
            "body": ["effect = {$0}"]
        },
        {
            "label": "cost",
            "description": "What taking the decision costs",
            "at": "field",
            "field": "cost",
            "body": ["cost = { gold = ${1:100} }"]
        },
        {
            "label": "ai_will_do",
            "description": "How much the AI wants to take the decision",
            "at": "field",
            "field": "ai_will_do",
            "body": ["ai_will_do = { base = ${1:50} }"]
        }
    ],
    "hints": [
        {
            "kind": "text",
            "field": "title"
        }
    ]
}
