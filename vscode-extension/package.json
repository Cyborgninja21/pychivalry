{
  "name": "ck3-language-support",
  "displayName": "Crusader Kings 3 Language Support",
  "description": "Language support for Crusader Kings 3 scripting language with LSP-powered features",
  "version": "2.2.0",
  "publisher": "cyborgninja21",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cyborgninja21/pychivalry.git"
  },
  "bugs": {
    "url": "https://github.com/Cyborgninja21/pychivalry/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "crusader kings 3",
    "ck3",
    "paradox",
    "modding",
    "language server"
  ],
  "activationEvents": [
    "onLanguage:ck3",
    "onLanguage:ck3-localization",
    "workspaceContains:**/descriptor.mod"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ck3",
        "aliases": [
          "Crusader Kings 3",
          "CK3"
        ],
        "extensions": [
          ".txt",
          ".gui",
          ".gfx",
          ".asset"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ck3-localization",
        "aliases": [
          "CK3 Localization",
          "Yaml (CK3)"
        ],
        "filenamePatterns": [
          "*_l_english.yml",
          "*_l_german.yml",
          "*_l_french.yml",
          "*_l_spanish.yml",
          "*_l_russian.yml",
          "*_l_korean.yml",
          "*_l_simp_chinese.yml",
          "*_l_braz_por.yml",
          "*_l_polish.yml",
          "*_l_japanese.yml"
        ],
        "configuration": "./language-configuration-localization.json"
      }
    ],
    "grammars": [
      {
        "language": "ck3",
        "scopeName": "source.ck3",
        "path": "./syntaxes/ck3.tmLanguage.json"
      },
      {
        "language": "ck3-localization",
        "scopeName": "source.ck3-localization",
        "path": "./syntaxes/ck3-localization.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ck3",
        "path": "./snippets/ck3.json"
      },
      {
        "language": "ck3-localization",
        "path": "./snippets/ck3-localization.json"
      }
    ],
    "commands": [
      {
        "command": "ck3LanguageServer.restart",
        "title": "Restart Language Server",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.extractTraitData",
        "title": "Extract Trait Data from CK3 Installation",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.extractLocalizationData",
        "title": "Extract Localization Data from CK3 Installation",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.discoverModData",
        "title": "Discover Mod Data (Carnalitas, etc.)",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.extractAllGameData",
        "title": "Extract All Game Data from CK3 Installation",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.showOutput",
        "title": "Show Output Channel",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.showMenu",
        "title": "Show Menu",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.openDocumentation",
        "title": "Open CK3 Modding Documentation",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.validateWorkspace",
        "title": "Validate Workspace",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.rescanWorkspace",
        "title": "Rescan Workspace",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.getWorkspaceStats",
        "title": "Show Workspace Statistics",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.generateEventTemplate",
        "title": "Generate Event Template",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.findOrphanedLocalization",
        "title": "Find Orphaned Localization",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.checkDependencies",
        "title": "Check Dependencies",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.showNamespaceEvents",
        "title": "Show Namespace Events",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.generateLocalizationStubs",
        "title": "Generate Localization Stubs",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.renameEvent",
        "title": "Rename Event",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.startLogWatcher",
        "title": "Start Game Log Watcher",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.stopLogWatcher",
        "title": "Stop Game Log Watcher",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.pauseLogWatcher",
        "title": "Pause Game Log Watcher",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.resumeLogWatcher",
        "title": "Resume Game Log Watcher",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.forceRefreshLogs",
        "title": "Force Refresh Game Logs",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.clearGameLogs",
        "title": "Clear Game Log Diagnostics",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.showLogStatistics",
        "title": "Show Game Log Statistics",
        "category": "CK3"
      },
      {
        "command": "ck3LanguageServer.refreshModExplorer",
        "title": "Refresh CK3 Explorer",
        "category": "CK3",
        "icon": "$(refresh)"
      },
      {
        "command": "ck3LanguageServer.revealModItem",
        "title": "Reveal Definition",
        "category": "CK3"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "ck3.modExplorer",
          "name": "CK3 Explorer",
          "when": "ck3.modExplorer.enabled"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "ck3LanguageServer.restart",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.showOutput",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.showMenu",
          "when": "false"
        },
        {
          "command": "ck3LanguageServer.openDocumentation",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.validateWorkspace",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.rescanWorkspace",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.getWorkspaceStats",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.generateEventTemplate",
          "when": "editorLangId == ck3"
        },
        {
          "command": "ck3LanguageServer.findOrphanedLocalization",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.checkDependencies",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.showNamespaceEvents",
          "when": "editorLangId == ck3"
        },
        {
          "command": "ck3LanguageServer.generateLocalizationStubs",
          "when": "editorLangId == ck3"
        },
        {
          "command": "ck3LanguageServer.renameEvent",
          "when": "editorLangId == ck3"
        },
        {
          "command": "ck3LanguageServer.startLogWatcher",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.stopLogWatcher",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.pauseLogWatcher",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.resumeLogWatcher",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.forceRefreshLogs",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.clearGameLogs",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.showLogStatistics",
          "when": "true"
        },
        {
          "command": "ck3LanguageServer.refreshModExplorer",
          "when": "ck3.modExplorer.enabled"
        },
        {
          "command": "ck3LanguageServer.revealModItem",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "ck3LanguageServer.refreshModExplorer",
          "when": "view == ck3.modExplorer",
          "group": "navigation"
        }
      ]
    },
    "configuration": [
      {
        "title": "General",
        "properties": {
          "ck3LanguageServer.args": {
            "type": "array",
            "default": [],
            "description": "Additional arguments to pass to the language server",
            "items": {
              "type": "string"
            },
            "scope": "resource"
          },
          "ck3LanguageServer.trace.server": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "default": "off",
            "description": "Traces the communication between VS Code and the language server",
            "scope": "window"
          },
          "ck3LanguageServer.logLevel": {
            "type": "string",
            "enum": [
              "debug",
              "info",
              "warning",
              "error"
            ],
            "default": "info",
            "description": "Log level for the language server. Setting to 'debug' enables additional Debug and Performance output channels.",
            "scope": "resource"
          },
          "ck3LanguageServer.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable/disable the CK3 language server",
            "scope": "resource"
          },
          "ck3LanguageServer.gamePath": {
            "type": "string",
            "default": "",
            "markdownDescription": "The CK3 `game` directory, the one holding `common/`, `events/` and `history/` (for example `C:\\Program Files (x86)\\Steam\\steamapps\\common\\Crusader Kings III\\game`). The mod is checked against this base game, so the vanilla scripted triggers, effects, lists, modifiers and script values it calls are known. When empty, the Steam default install locations are tried once; when none holds `common/`, the mod is checked without a base game and every vanilla scripted name it calls is reported as unknown.",
            "scope": "machine-overridable"
          }
        }
      },
      {
        "title": "Formatting",
        "properties": {
          "ck3LanguageServer.formatting.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable document, range and on-type formatting for CK3 files",
            "scope": "resource"
          },
          "ck3LanguageServer.formatting.onTypeEnabled": {
            "type": "boolean",
            "default": true,
            "description": "Format as you type: indent a new line to its block depth after Enter, align a closing brace with the line that opened its block, and pad '=' (needs editor.formatOnType, which the extension turns on for CK3 files)",
            "scope": "resource"
          },
          "ck3LanguageServer.formatting.insertSpaces": {
            "type": "boolean",
            "default": false,
            "description": "Indent with spaces instead of tabs, in document, range and on-type formatting (Paradox convention uses tabs)",
            "scope": "resource"
          },
          "ck3LanguageServer.formatting.tabSize": {
            "type": "number",
            "default": 4,
            "description": "Spaces per indentation level when insertSpaces is on",
            "scope": "resource"
          }
        }
      },
      {
        "title": "Inlay Hints",
        "properties": {
          "ck3LanguageServer.inlayHints.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable inlay hints for CK3 scripts",
            "scope": "resource"
          },
          "ck3LanguageServer.inlayHints.showScopeTypes": {
            "type": "boolean",
            "default": true,
            "description": "Show type hints after saved scopes (e.g., scope:friend → : character)",
            "scope": "resource"
          },
          "ck3LanguageServer.inlayHints.showChainTypes": {
            "type": "boolean",
            "default": true,
            "description": "Show type hints after scope chains (e.g., root.primary_title → : landed_title)",
            "scope": "resource"
          },
          "ck3LanguageServer.inlayHints.showIteratorTypes": {
            "type": "boolean",
            "default": true,
            "description": "Show type hints for list iterators (e.g., every_vassal → → character)",
            "scope": "resource"
          },
          "ck3LanguageServer.inlayHints.maxHintsPerLine": {
            "type": "number",
            "default": 3,
            "minimum": 1,
            "maximum": 10,
            "description": "Maximum number of inlay hints to show per line",
            "scope": "resource"
          }
        }
      },
      {
        "title": "Background Validation",
        "properties": {
          "ck3LanguageServer.backgroundValidation.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Validate every script and localization file of the workspace in the background after startup, re-validate files changed on disk and, on save, the files that use what the saved file defines. Results appear in the Problems panel for unopened files too, in the Explorer badges and in the status bar.",
            "scope": "resource"
          },
          "ck3LanguageServer.backgroundValidation.concurrency": {
            "type": "number",
            "default": 5,
            "minimum": 1,
            "maximum": 50,
            "description": "Files read ahead at once by background validation. Files are diagnosed one at a time with a pause after each, so the editor stays responsive.",
            "scope": "resource"
          },
          "ck3LanguageServer.backgroundValidation.fileLimit": {
            "type": "number",
            "default": 3000,
            "minimum": 0,
            "description": "Above this many files only open files are validated in the background. Run 'CK3: Validate Workspace' to validate every file anyway, or raise the limit.",
            "scope": "resource"
          }
        }
      },
      {
        "title": "Graphics Files",
        "properties": {
          "ck3LanguageServer.graphics.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Report references to graphics files (`.dds`, `.png`, `.tga`) that exist neither in the workspace mods nor in the base game's `game/` and `game/dlc/*` folders (GFX001), before the game shows a pink or black checkerboard. Paths are compared case-insensitively. Nothing is reported while no base game is known (`ck3LanguageServer.gamePath`): without it a miss cannot be proven.",
            "scope": "resource"
          }
        }
      },
      {
        "title": "Game Log Watcher",
        "properties": {
          "ck3LanguageServer.logWatcher.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable the CK3 game log watcher for real-time error detection",
            "scope": "resource",
            "order": 1
          },
          "ck3LanguageServer.logWatcher.autoStart": {
            "type": "boolean",
            "default": false,
            "description": "Automatically start watching game logs when opening a CK3 workspace",
            "scope": "resource",
            "order": 2
          },
          "ck3LanguageServer.logWatcher.logPath": {
            "type": "string",
            "default": "",
            "description": "Custom path to CK3 logs directory (leave empty for auto-detection)",
            "scope": "resource",
            "order": 3
          },
          "ck3LanguageServer.logWatcher.showInOutput": {
            "type": "boolean",
            "default": true,
            "description": "Show game log entries in the GameLogs output channel",
            "scope": "resource",
            "order": 4
          },
          "ck3LanguageServer.logWatcher.maxLogSize": {
            "type": "number",
            "default": 100,
            "minimum": 10,
            "maximum": 1000,
            "description": "Maximum size of game.log to process in MB (older content will be skipped)",
            "scope": "resource",
            "order": 5
          },
          "ck3LanguageServer.logWatcher.debounceDelay": {
            "type": "number",
            "default": 500,
            "minimum": 100,
            "maximum": 5000,
            "description": "Delay in milliseconds before processing log changes (reduces CPU usage)",
            "scope": "resource",
            "order": 6
          },
          "ck3LanguageServer.logWatcher.patterns": {
            "type": "array",
            "default": [],
            "description": "Additional custom regex patterns for error detection",
            "items": {
              "type": "object",
              "properties": {
                "pattern": {
                  "type": "string",
                  "description": "Regular expression pattern to match"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "error",
                    "warning",
                    "info"
                  ],
                  "description": "Severity level for matched patterns"
                },
                "message": {
                  "type": "string",
                  "description": "Custom message template (use {0}, {1} for capture groups)"
                }
              }
            },
            "scope": "resource",
            "order": 7
          }
        }
      }
    ],
    "configurationDefaults": {
      "[ck3]": {
        "editor.formatOnType": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "webpack",
    "watch": "webpack --watch",
    "bundle": "webpack --mode production --devtool source-map",
    "package": "vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out --preserveWatchOutput",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js",
    "test:integration": "npm run pretest && node ./out/test/runTest.js",
    "test:quick": "npm run compile-tests && node ./out/test/runTest.js",
    "test:unit": "mocha ./out/test/unit/**/*.test.js",
    "test:examples": "mocha ./out/test/unit/example-mod-validation.test.js",
    "test:watch": "mocha \"./out/test/unit/**/*.test.js\" --watch --watch-files \"out/**/*.js,../packages/engine/dist/**/*.js\" --enable-source-maps --timeout 15000",
    "lint": "eslint src --ext ts --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\"",
    "format-check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^8.0.0",
    "glob": "^10.0.0",
    "mocha": "^10.0.0",
    "prettier": "^3.0.0",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "js-yaml": "^4.1.1",
    "pychivalry-engine": "2.2.0",
    "vscode-languageclient": "^9.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
