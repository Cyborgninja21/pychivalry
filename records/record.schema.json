{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/Cyborgninja21/pychivalry/blob/main/records/record.schema.json",
    "title": "pychivalry suite record",
    "description": "One run of a suite that needs game files, made by a local task and committed. The format is described in records/README.md; `task records:check` validates every record against this schema and checks that its spec is the committed one.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "record_format",
        "suite",
        "command",
        "made_at",
        "tool",
        "machine",
        "game",
        "spec",
        "corpus",
        "results"
    ],
    "properties": {
        "record_format": {
            "description": "The version of this format. A change that a reader of the old format would misread raises it.",
            "const": 1
        },
        "suite": {
            "description": "Which suite made the record.",
            "enum": ["game:parse", "game:check", "game:mods", "game:bench", "baseline:speed"]
        },
        "command": {
            "description": "The command that made the record, with `<game dir>` and `<corpus dir>` in place of local paths.",
            "type": "string",
            "minLength": 1
        },
        "made_at": {
            "description": "When the record was made, in UTC.",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "tool": { "$ref": "#/$defs/tool" },
        "machine": { "$ref": "#/$defs/machine" },
        "game": { "$ref": "#/$defs/game" },
        "spec": { "$ref": "#/$defs/spec" },
        "corpus": {
            "description": "The mod corpus the run read, or null for a suite that reads no mods.",
            "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/corpus" }]
        },
        "notes": {
            "description": "What a reader must know to interpret the results, in plain sentences.",
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
        },
        "results": {
            "description": "The suite's results. Each suite's shape is defined with the step that builds the suite; a stub writes an empty object.",
            "type": "object"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": { "suite": { "const": "baseline:speed" } },
                "required": ["suite"]
            },
            "then": {
                "properties": {
                    "notes": { "type": "array", "minItems": 1 },
                    "results": { "$ref": "#/$defs/speedResults" }
                },
                "required": ["notes"]
            }
        },
        {
            "if": {
                "properties": { "suite": { "const": "game:parse" } },
                "required": ["suite"]
            },
            "then": {
                "properties": {
                    "notes": { "type": "array", "minItems": 1 },
                    "results": { "$ref": "#/$defs/parseResults" }
                },
                "required": ["notes"]
            }
        }
    ],
    "$defs": {
        "count": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1 },
        "extension": { "type": "string", "pattern": "^\\.[a-z0-9]+$" },
        "parseResults": {
            "description": "The base-game parse suite (records/README.md, \"Parse records\"): the folders read, every parse error with its classification, the information notes, the text files not read, and how every text file of the game is encoded.",
            "type": "object",
            "additionalProperties": false,
            "required": ["passed", "failures", "files", "trees", "parse_ms", "folders", "errors", "notes", "not_read", "encoding"],
            "properties": {
                "passed": { "type": "boolean" },
                "failures": { "type": "array", "items": { "$ref": "#/$defs/text" } },
                "files": { "$ref": "#/$defs/count" },
                "trees": { "$ref": "#/$defs/count" },
                "parse_ms": { "$ref": "#/$defs/count" },
                "folders": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["folder", "extension", "expected_files", "files", "trees", "bom", "not_utf8", "errors", "parse_ms", "why", "excluded"],
                        "properties": {
                            "folder": { "$ref": "#/$defs/text" },
                            "extension": { "$ref": "#/$defs/extension" },
                            "expected_files": { "$ref": "#/$defs/count" },
                            "files": { "$ref": "#/$defs/count" },
                            "trees": { "$ref": "#/$defs/count" },
                            "bom": { "$ref": "#/$defs/count" },
                            "not_utf8": { "$ref": "#/$defs/count" },
                            "errors": { "$ref": "#/$defs/count" },
                            "parse_ms": { "$ref": "#/$defs/count" },
                            "why": { "$ref": "#/$defs/text" },
                            "excluded": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": ["file", "why"],
                                    "properties": { "file": { "$ref": "#/$defs/text" }, "why": { "$ref": "#/$defs/text" } }
                                }
                            }
                        }
                    }
                },
                "errors": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["file", "line", "column", "id", "catalogue", "message", "classification", "reason"],
                        "properties": {
                            "file": { "$ref": "#/$defs/text" },
                            "line": { "type": "integer", "minimum": 1 },
                            "column": { "type": "integer", "minimum": 1 },
                            "id": { "$ref": "#/$defs/text" },
                            "catalogue": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] },
                            "message": { "$ref": "#/$defs/text" },
                            "classification": { "enum": ["game-defect", "pychivalry-fault", "unclassified"] },
                            "reason": { "type": "string" }
                        }
                    }
                },
                "notes": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["file", "line", "column", "id", "message"],
                        "properties": {
                            "file": { "$ref": "#/$defs/text" },
                            "line": { "type": "integer", "minimum": 1 },
                            "column": { "type": "integer", "minimum": 1 },
                            "id": { "$ref": "#/$defs/text" },
                            "message": { "$ref": "#/$defs/text" }
                        }
                    }
                },
                "not_read": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["what", "why"],
                        "properties": { "what": { "$ref": "#/$defs/text" }, "why": { "$ref": "#/$defs/text" } }
                    }
                },
                "encoding": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["extensions", "files", "bom", "utf16_bom", "not_utf8", "line_endings", "by_folder", "not_utf8_files"],
                    "properties": {
                        "extensions": { "type": "array", "items": { "$ref": "#/$defs/extension" } },
                        "files": { "$ref": "#/$defs/count" },
                        "bom": { "$ref": "#/$defs/count" },
                        "utf16_bom": { "$ref": "#/$defs/count" },
                        "not_utf8": { "$ref": "#/$defs/count" },
                        "line_endings": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["lf", "crlf", "cr", "mixed", "none"],
                            "properties": {
                                "lf": { "$ref": "#/$defs/count" },
                                "crlf": { "$ref": "#/$defs/count" },
                                "cr": { "$ref": "#/$defs/count" },
                                "mixed": { "$ref": "#/$defs/count" },
                                "none": { "$ref": "#/$defs/count" }
                            }
                        },
                        "by_folder": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["folder", "extension", "files", "bom", "not_utf8"],
                                "properties": {
                                    "folder": { "$ref": "#/$defs/text" },
                                    "extension": { "$ref": "#/$defs/extension" },
                                    "files": { "$ref": "#/$defs/count" },
                                    "bom": { "$ref": "#/$defs/count" },
                                    "not_utf8": { "$ref": "#/$defs/count" }
                                }
                            }
                        },
                        "not_utf8_files": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["file", "invalid_bytes", "first_line", "in_comments", "in_strings", "elsewhere", "valid_multibyte_sequences"],
                                "properties": {
                                    "file": { "$ref": "#/$defs/text" },
                                    "invalid_bytes": { "type": "integer", "minimum": 1 },
                                    "first_line": { "type": "integer", "minimum": 1 },
                                    "in_comments": { "$ref": "#/$defs/count" },
                                    "in_strings": { "$ref": "#/$defs/count" },
                                    "elsewhere": { "$ref": "#/$defs/count" },
                                    "valid_multibyte_sequences": { "$ref": "#/$defs/count" }
                                }
                            }
                        }
                    }
                }
            }
        },
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "tool": {
            "description": "The build of pychivalry that made the record.",
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "commit", "dirty"],
            "properties": {
                "name": { "const": "pychivalry" },
                "version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
                },
                "commit": {
                    "description": "The git commit the tool was built from.",
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "dirty": {
                    "description": "True when tracked files outside records/ differed from that commit.",
                    "type": "boolean"
                }
            }
        },
        "machine": {
            "description": "The machine, described generically: nothing that identifies it or its owner.",
            "type": "object",
            "additionalProperties": false,
            "required": ["os", "arch", "logical_cpus", "memory_gib", "node"],
            "properties": {
                "os": { "enum": ["linux", "win32", "darwin"] },
                "arch": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "logical_cpus": { "type": "integer", "minimum": 1 },
                "memory_gib": { "type": "integer", "minimum": 1 },
                "node": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
            }
        },
        "game": {
            "description": "The installed game the run read.",
            "type": "object",
            "additionalProperties": false,
            "required": ["build", "manifest_sha256", "files", "content_hashed_files"],
            "properties": {
                "build": {
                    "description": "The game build, from the launcher's settings file (`rawVersion`).",
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)+$"
                },
                "manifest_sha256": {
                    "description": "SHA-256 of the game's file manifest, defined in records/README.md.",
                    "$ref": "#/$defs/sha256"
                },
                "files": { "type": "integer", "minimum": 0 },
                "content_hashed_files": { "type": "integer", "minimum": 0 }
            }
        },
        "spec": {
            "description": "The spec package the run used.",
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "sha256", "package_format"],
            "properties": {
                "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)+$" },
                "sha256": {
                    "description": "SHA-256 of the package's uncompressed bytes.",
                    "$ref": "#/$defs/sha256"
                },
                "package_format": { "type": "integer", "minimum": 1 }
            }
        },
        "corpus": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manifest_sha256", "slugs"],
            "properties": {
                "manifest_sha256": {
                    "description": "SHA-256 of records/corpus/MANIFEST.tsv as committed when the run was made.",
                    "$ref": "#/$defs/sha256"
                },
                "slugs": {
                    "description": "The mods the run read.",
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
                }
            }
        },
        "speedResults": {
            "description": "Timings and memory of one or more series of runs.",
            "type": "object",
            "additionalProperties": false,
            "required": ["series"],
            "properties": {
                "series": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/series" }
                }
            }
        },
        "series": {
            "description": "Repeated runs of one measurement on one input.",
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "method", "mod", "runs", "measures", "context"],
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "method": {
                    "description": "How the runs were made; records/README.md describes each method.",
                    "enum": ["corpus-acceptance", "vanilla-acceptance", "editor"]
                },
                "mod": {
                    "description": "The corpus slug, or null for the base game alone.",
                    "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }]
                },
                "runs": {
                    "description": "Every run, in the order made; the first is the first run after a fresh process.",
                    "type": "integer",
                    "minimum": 6
                },
                "measures": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": { "$ref": "#/$defs/measure" }
                },
                "context": {
                    "description": "Facts about the runs that are not measures (file counts, editor version, load average).",
                    "type": "object"
                }
            }
        },
        "measure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit", "first", "later"],
            "properties": {
                "unit": { "enum": ["ms", "KiB"] },
                "first": {
                    "description": "The first run of the series. Not a cold start: see the record's notes.",
                    "type": "number",
                    "minimum": 0
                },
                "later": { "$ref": "#/$defs/stats" }
            }
        },
        "stats": {
            "description": "The runs after the first: their median and spread (max minus min), and every value.",
            "type": "object",
            "additionalProperties": false,
            "required": ["n", "median", "min", "max", "spread", "values"],
            "properties": {
                "n": { "type": "integer", "minimum": 5 },
                "median": { "type": "number", "minimum": 0 },
                "min": { "type": "number", "minimum": 0 },
                "max": { "type": "number", "minimum": 0 },
                "spread": { "type": "number", "minimum": 0 },
                "values": {
                    "type": "array",
                    "minItems": 5,
                    "items": { "type": "number", "minimum": 0 }
                }
            }
        }
    }
}
