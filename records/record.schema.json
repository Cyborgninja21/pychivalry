{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/Cyborgninja21/pychivalry/blob/main/records/record.schema.json",
    "title": "pychivalry suite record",
    "description": "One run of a suite that needs game files, made by a local task and committed. The format is described in records/README.md; `task records:check` validates every record against this schema and checks that its spec is the committed one.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "record_format",
        "suite",
        "command",
        "made_at",
        "tool",
        "machine",
        "game",
        "spec",
        "corpus",
        "results"
    ],
    "properties": {
        "record_format": {
            "description": "The version of this format. A change that a reader of the old format would misread raises it.",
            "const": 1
        },
        "suite": {
            "description": "Which suite made the record.",
            "enum": ["game:parse", "game:check", "game:mods", "game:bench", "baseline:speed"]
        },
        "command": {
            "description": "The command that made the record, with `<game dir>` and `<corpus dir>` in place of local paths.",
            "type": "string",
            "minLength": 1
        },
        "made_at": {
            "description": "When the record was made, in UTC.",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "tool": { "$ref": "#/$defs/tool" },
        "machine": { "$ref": "#/$defs/machine" },
        "game": { "$ref": "#/$defs/game" },
        "spec": { "$ref": "#/$defs/spec" },
        "corpus": {
            "description": "The mod corpus the run read, or null for a suite that reads no mods.",
            "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/corpus" }]
        },
        "notes": {
            "description": "What a reader must know to interpret the results, in plain sentences.",
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
        },
        "results": {
            "description": "The suite's results. Each suite's shape is defined with the step that builds the suite; a stub writes an empty object.",
            "type": "object"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": { "suite": { "const": "baseline:speed" } },
                "required": ["suite"]
            },
            "then": {
                "properties": {
                    "notes": { "type": "array", "minItems": 1 },
                    "results": { "$ref": "#/$defs/speedResults" }
                },
                "required": ["notes"]
            }
        }
    ],
    "$defs": {
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "tool": {
            "description": "The build of pychivalry that made the record.",
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "commit", "dirty"],
            "properties": {
                "name": { "const": "pychivalry" },
                "version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
                },
                "commit": {
                    "description": "The git commit the tool was built from.",
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "dirty": {
                    "description": "True when tracked files outside records/ differed from that commit.",
                    "type": "boolean"
                }
            }
        },
        "machine": {
            "description": "The machine, described generically: nothing that identifies it or its owner.",
            "type": "object",
            "additionalProperties": false,
            "required": ["os", "arch", "logical_cpus", "memory_gib", "node"],
            "properties": {
                "os": { "enum": ["linux", "win32", "darwin"] },
                "arch": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "logical_cpus": { "type": "integer", "minimum": 1 },
                "memory_gib": { "type": "integer", "minimum": 1 },
                "node": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
            }
        },
        "game": {
            "description": "The installed game the run read.",
            "type": "object",
            "additionalProperties": false,
            "required": ["build", "manifest_sha256", "files", "content_hashed_files"],
            "properties": {
                "build": {
                    "description": "The game build, from the launcher's settings file (`rawVersion`).",
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)+$"
                },
                "manifest_sha256": {
                    "description": "SHA-256 of the game's file manifest, defined in records/README.md.",
                    "$ref": "#/$defs/sha256"
                },
                "files": { "type": "integer", "minimum": 0 },
                "content_hashed_files": { "type": "integer", "minimum": 0 }
            }
        },
        "spec": {
            "description": "The spec package the run used.",
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "sha256", "package_format"],
            "properties": {
                "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)+$" },
                "sha256": {
                    "description": "SHA-256 of the package's uncompressed bytes.",
                    "$ref": "#/$defs/sha256"
                },
                "package_format": { "type": "integer", "minimum": 1 }
            }
        },
        "corpus": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manifest_sha256", "slugs"],
            "properties": {
                "manifest_sha256": {
                    "description": "SHA-256 of records/corpus/MANIFEST.tsv as committed when the run was made.",
                    "$ref": "#/$defs/sha256"
                },
                "slugs": {
                    "description": "The mods the run read.",
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
                }
            }
        },
        "speedResults": {
            "description": "Timings and memory of one or more series of runs.",
            "type": "object",
            "additionalProperties": false,
            "required": ["series"],
            "properties": {
                "series": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/series" }
                }
            }
        },
        "series": {
            "description": "Repeated runs of one measurement on one input.",
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "method", "mod", "runs", "measures", "context"],
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "method": {
                    "description": "How the runs were made; records/README.md describes each method.",
                    "enum": ["corpus-acceptance", "vanilla-acceptance", "editor"]
                },
                "mod": {
                    "description": "The corpus slug, or null for the base game alone.",
                    "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }]
                },
                "runs": {
                    "description": "Every run, in the order made; the first is the first run after a fresh process.",
                    "type": "integer",
                    "minimum": 6
                },
                "measures": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": { "$ref": "#/$defs/measure" }
                },
                "context": {
                    "description": "Facts about the runs that are not measures (file counts, editor version, load average).",
                    "type": "object"
                }
            }
        },
        "measure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit", "first", "later"],
            "properties": {
                "unit": { "enum": ["ms", "KiB"] },
                "first": {
                    "description": "The first run of the series. Not a cold start: see the record's notes.",
                    "type": "number",
                    "minimum": 0
                },
                "later": { "$ref": "#/$defs/stats" }
            }
        },
        "stats": {
            "description": "The runs after the first: their median and spread (max minus min), and every value.",
            "type": "object",
            "additionalProperties": false,
            "required": ["n", "median", "min", "max", "spread", "values"],
            "properties": {
                "n": { "type": "integer", "minimum": 5 },
                "median": { "type": "number", "minimum": 0 },
                "min": { "type": "number", "minimum": 0 },
                "max": { "type": "number", "minimum": 0 },
                "spread": { "type": "number", "minimum": 0 },
                "values": {
                    "type": "array",
                    "minItems": 5,
                    "items": { "type": "number", "minimum": 0 }
                }
            }
        }
    }
}
