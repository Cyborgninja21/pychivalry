# Every text file is checked out with LF on every platform. Prettier, the spec and record
# checksums, and the CK3 fixtures all expect LF; without this, Windows would check sources
# out with CRLF and the format check would fail on every file.
* text=auto eol=lf

# Binary data: never converted.
*.gz binary

# The spec package, committed as pdx-parser-re built it: gzipped JSON whose checksums are of
# the uncompressed bytes, and its JSON Schema, byte for byte (spec/README.md). No platform may
# rewrite them.
spec/**/*.json.gz binary
spec/schema.format9.json -text
*.png binary
*.dds binary
*.tga binary

# Fixtures that exist to test another encoding: their bytes are exact.
fixtures/mods/encoding-windows-1252/history/** -text

# The formatter's fixtures: line breaks and byte-order marks are what they test, so their bytes
# are exact on every platform (the style/ pairs, the golden files of fixtures/format/).
fixtures/mods/style-*/** -text
fixtures/format/** -text
# Every fixture mod and the planted-defect mod are in pychivalry's format (Windows line breaks and
# the byte-order mark), but for what a fixture exists to test (fixtures/README.md): the bytes of
# their script and localization files are exact on every platform.
fixtures/mods/**/*.txt -text
fixtures/mods/**/*.yml -text
fixtures/defects/**/*.txt -text
fixtures/defects/**/*.yml -text
# The content requests' base mods and example results, in the format too (fixtures/requests/).
fixtures/requests/**/*.txt -text
fixtures/requests/**/*.yml -text

# GUI fixture files (build step 10): not in the formatter, and kept byte for byte, written with
# Windows line breaks and the byte-order mark as the other fixture files are.
fixtures/mods/**/*.gui -text
fixtures/game/**/*.gui -text
