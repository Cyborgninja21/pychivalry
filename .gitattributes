# Every text file is checked out with LF on every platform. Prettier, the spec and record
# checksums, and the CK3 fixtures all expect LF; without this, Windows would check sources
# out with CRLF and the format check would fail on every file.
* text=auto eol=lf

# Binary data: never converted.
*.gz binary

# The spec package, committed as pdx-parser-re built it: gzipped JSON whose checksums are of
# the uncompressed bytes, and its JSON Schema, byte for byte (spec/README.md). No platform may
# rewrite them.
spec/**/*.json.gz binary
spec/schema.format8.json -text
*.png binary
*.dds binary
*.tga binary

# Fixtures that exist to test another encoding: their bytes are exact.
fixtures/mods/encoding-windows-1252/history/** -text
